# Supabase（控制台 Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# DeepSeek（只在服务端使用，不要加 NEXT_PUBLIC_ 前缀）
DEEPSEEK_API_KEY=sk-xxx
# 可选：换成其他 OpenAI 兼容服务
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 可选：每个用户 24 小时内的生成次数上限
# DAILY_GENERATION_LIMIT=40
# GUEST_DAILY_GENERATION_LIMIT=10

# 可选：设为 1 时使用离线演示模型（不消耗 token，用于本地开发和测试）
# LLM_MOCK=1

# 可选：自定义智能体（JSON 数组），会按 after 插入到内置团队中，建议交给工程师 Alex 落地
# CUSTOM_AGENTS=[{"id":"a11y","name":"Iris","title":"无障碍顾问","color":"#06b6d4","instructions":"检查对比度、键盘操作与语义化标签","after":"architect","flows":["create","edit"]}]
